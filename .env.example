# Public Turnstile widget key. Inlined at build time by Next.js.
NEXT_PUBLIC_CONTACT_TURNSTILE_SITE_KEY=
# Server-only Turnstile Siteverify secret.
CONTACT_TURNSTILE_SECRET_KEY=
# Comma-separated exact hostnames from verified Turnstile responses.
CONTACT_TURNSTILE_HOSTNAMES=usama-portfolio-v2.vercel.app
# Separate Resend key with Sending access, restricted to the verified sender domain.
CONTACT_RESEND_API_KEY=
# Verified Resend sender identity, e.g. Portfolio <contact@your-verified-domain>.
CONTACT_FROM_EMAIL=
